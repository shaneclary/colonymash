# Canonical address of the live site. Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.colonymashbrewing.com

# Leave unset on staging. While unset, every page is noindex and the site runs
# in review mode: unconfirmed facts show a dashed "Confirm" tag and empty photo
# slots show their brief. Set to "true" only at launch, once docs/LAUNCH.md is done.
NEXT_PUBLIC_INDEXABLE=
